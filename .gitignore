*.o
*.obj
*.d
*.elf
*.map
*.exe
*.pdb
*.ilk
*.gcda
*.gcno
*.log
*.tmp

# Do not ignore *.bin or *.a globally: image payloads and vendored
# third-party libraries are build inputs, not disposable build output.
