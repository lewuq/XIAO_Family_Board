# ESP-IDF, CMake and PlatformIO build output
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
.pio/
sdkconfig.old

# Installed tools and caches
node_modules/
__pycache__/
*.py[cod]
.cache/
